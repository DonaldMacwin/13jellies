---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleExplorer from '../components/ArticleExplorer';
import { findNearestArticle, getAllArticles } from '../lib/articles';

const articles = getAllArticles();
const defaultSpaceIndex = 0;
const defaultTimeIndex = 10;
const initialArticle = findNearestArticle(articles, defaultSpaceIndex, defaultTimeIndex) ?? articles[0];
---

<BaseLayout title={initialArticle?.title ?? 'Spatiotemporal Scaler'}>
	<ArticleExplorer client:load articles={articles} initialSlug={initialArticle?.slug} updateUrl={false} />
</BaseLayout>

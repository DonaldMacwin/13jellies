---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleExplorer from '../components/ArticleExplorer';
import { findNearestArticle, getAllArticles, getAllArticleSummaries } from '../lib/articles';

const allArticles = getAllArticles();
const articles = getAllArticleSummaries();
const defaultSpaceIndex = 0;
const defaultTimeIndex = 9;
const initialArticle = findNearestArticle(allArticles, defaultSpaceIndex, defaultTimeIndex) ?? allArticles[0];
---

<BaseLayout title={initialArticle?.title ?? 'Spatiotemporal Scaler'}>
	<ArticleExplorer client:load articles={articles} initialArticle={initialArticle} updateUrl={false} />
</BaseLayout>

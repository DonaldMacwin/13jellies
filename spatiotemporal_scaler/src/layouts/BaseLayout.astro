---
import '../styles/global.css';
import Footer from '../components/common/Footer.astro';

interface Props {
	title?: string;
}

const { title = 'Spatiotemporal Scaler' } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="viewport" content="width=device-width,user-scalable=yes,initial-scale=1" />
		<meta name="apple-mobile-web-app-title" content="バカンス時空間スケーラー" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="description" content="バカンス時空間スケーラー" />
		<meta name="keywords" content="バカンス時空間スケーラー" />
		<meta property="og:type" content="website" />
		<meta property="og:description" content="バカンス時空間スケーラー" />
		<meta property="og:url" content="https://cf268321.cloudfree.jp/13jellies/spatiotemporal_scaler/" />
		<meta property="og:site_name" content="バカンス時空間スケーラー" />
		<meta property="og:image" content="https://cf268321.cloudfree.jp/13jellies/asset/img/ogp.png" />
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:image" content="https://cf268321.cloudfree.jp/13jellies/asset/img/ogp.png">

		<link rel="canonical" href="https://cf268321.cloudfree.jp/13jellies/index.php" />
		<link rel="alternate" type="application/rss+xml" title="バカンス時空間スケーラー" />
		<link rel="dns-prefetch" href="//cf268321.cloudfree.jp/13jellies/index.php" />
		<link rel="shortcut icon" href="https://cf268321.cloudfree.jp/club1300/assets/img/club1300.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100;300;500;700;900&display=swap">
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;500;700;900&display=swap">
		<link rel="stylesheet" href="https://cf268321.cloudfree.jp/13jellies/asset/css/common.css" />
		
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-TDGYXHRXTD"></script>
		<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());

		gtag('config', 'G-TDGYXHRXTD');
		</script>
		<title>{title}｜バカンス時空間スケーラー</title>
	</head>
	<body>
		<div class="scaling-root">
			<div class="scaling-content">
				<section class="scaling-page active">
					<div class="page-fragment">
						<slot />
					</div>
					<Footer />
				</section>
			</div>
		</div>
		<button
			type="button"
			class="back-to-top"
			aria-label="ページTOPへ"
			title="ページTOPへ"
			id="back-to-top"
		>
			▲
		</button>
		<script>
			const backToTopButton = document.getElementById('back-to-top');
			backToTopButton?.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			window.addEventListener('message', (event) => {
				if (!event.data || event.data.type !== 'footer-frame-height') {
					return;
				}

				const iframe = document.querySelector('.external-footer-frame');
				if (iframe instanceof HTMLIFrameElement && typeof event.data.height === 'number') {
					iframe.style.height = `${Math.max(320, event.data.height)}px`;
				}
			});
		</script>
	</body>
</html>
